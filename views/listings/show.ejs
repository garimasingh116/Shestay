<% layout("/layouts/boilerplate") %>

<body class="bg-light">

  <div class="container my-5">

    <h3 class="mb-4 text-center text-primary">
      Listing Details
    </h3>

    <div class="card shadow">

      <div class="card-body">

        <ul class="list-group list-group-flush">

          <li class="list-group-item">
            <strong>Title:</strong>
            <%= listing.title %>
          </li>

          <% if (listing.owner) { %>
            <li class="list-group-item">
              <strong>Hosted By:</strong>
              <i><%= listing.owner.username %></i>
            </li>
          <% } %>

          <li class="list-group-item">
            <strong>Description:</strong>
            <%= listing.description %>
          </li>

          <li class="list-group-item">

            <strong>Image:</strong><br><br>

            <% if (listing.image && listing.image.url) { %>

              <img
                src="<%= listing.image.url %>"
                class="img-fluid rounded shadow"
                style="max-height: 400px;"
              >

            <% } else { %>

              <p>No image uploaded.</p>

            <% } %>

          </li>

          <li class="list-group-item">
            <strong>Price:</strong>
            ₹<%= listing.price %>
          </li>

          <li class="list-group-item">
            <strong>Location:</strong>
            <%= listing.location %>,
            <%= listing.country %>
          </li>

          <li class="list-group-item">
            <strong>Women Only:</strong>
            <%= listing.isWomenOnly ? "Yes" : "No" %>
          </li>

          <li class="list-group-item">
            <strong>Host Gender:</strong>
            <%= listing.hostGender %>
          </li>

          <li class="list-group-item">
            <strong>Secure Lock:</strong>
            <%= listing.hasSecureLock ? "Yes" : "No" %>
          </li>

          <li class="list-group-item">
            <strong>Emergency Support:</strong>
            <%= listing.emergencySupport ? "Yes" : "No" %>
          </li>

          <li class="list-group-item">

  <strong>AI Safety Score:</strong>

  <div class="progress mt-2">

    <div
      class="progress-bar bg-success"
      role="progressbar"
      style="width:<%= listing.safetyRating %>%"
    >

      <%= listing.safetyRating %>/100

    </div>

  </div>

  <% if(listing.safetyRating >= 80){ %>

    <span class="badge bg-success mt-2">
      Highly Safe
    </span>

  <% } else if(listing.safetyRating >= 60){ %>

    <span class="badge bg-warning text-dark mt-2">
      Moderately Safe
    </span>

  <% } else { %>

    <span class="badge bg-danger mt-2">
      Safety Needs Improvement
    </span>

  <% } %>

</li>
          <!-- NEW WOMEN SAFETY FEATURES -->

          <li class="list-group-item">
            <strong>24/7 Security:</strong>
            <%= listing.security24x7 ? "Yes" : "No" %>
          </li>

          <li class="list-group-item">
            <strong>CCTV Available:</strong>
            <%= listing.hasCCTV ? "Yes" : "No" %>
          </li>

          <li class="list-group-item">
            <strong>Female Staff Available:</strong>
            <%= listing.femaleStaffAvailable ? "Yes" : "No" %>
          </li>

          <li class="list-group-item">
            <strong>Late Night Check-in:</strong>
            <%= listing.lateNightCheckin ? "Yes" : "No" %>
          </li>

          <li class="list-group-item">
            <strong>Well Lit Area:</strong>
            <%= listing.wellLitArea ? "Yes" : "No" %>
          </li>

          <li class="list-group-item">
            <strong>Night Cab Availability:</strong>
            <%= listing.cabAvailabilityNight ? "Yes" : "No" %>
          </li>

          <li class="list-group-item">
            <strong>Nearby Police Station:</strong>
            <%= listing.nearbyPoliceStation ? "Yes" : "No" %>
          </li>

          <li class="list-group-item">
            <strong>Public Transport Nearby:</strong>
            <%= listing.publicTransportNearby ? "Yes" : "No" %>
          </li>

        </ul>

        <!-- AI SAFETY INSIGHT -->
<div class="alert alert-info mt-4 shadow-sm">

    <h5 class="text-primary">
        🤖 AI Safety Insight
    </h5>

    <% if (listing.aiReviewSummary && listing.aiReviewSummary.summary) { %>

        <h6>
            <strong>
                <%= listing.aiReviewSummary.overallVerdict %>
            </strong>

            (<%= listing.aiReviewSummary.overallSafetyScore %>/100)
        </h6>

        <p>
            <%= listing.aiReviewSummary.summary %>
        </p>

        <% if (listing.aiReviewSummary.strengths.length) { %>

            <strong>Key Strengths</strong>

            <ul>
                <% listing.aiReviewSummary.strengths.forEach(function(item){ %>
                    <li><%= item %></li>
                <% }) %>
            </ul>

        <% } %>

        <% if (listing.aiReviewSummary.concerns.length) { %>

            <strong>Potential Concerns</strong>

            <ul>
                <% listing.aiReviewSummary.concerns.forEach(function(item){ %>
                    <li><%= item %></li>
                <% }) %>
            </ul>

        <% } %>

        <div class="mt-3">
            <strong>Recommendation:</strong>
            <%= listing.aiReviewSummary.recommendation %>
        </div>

    <% } else { %>

        <p>
            AI review summary is not available yet.
        </p>

    <% } %>

</div>

      </div>
    </div>
<!-- BOOKING / PAYMENT -->

<div class="text-center mt-4">

  <% if(currUser){ %>

    <button
      id="pay-btn"
      class="btn btn-success btn-lg px-5 shadow">

      <i class="fa-solid fa-credit-card me-2"></i>

      Book Now - ₹<%= listing.price %>

    </button>

  <% } else { %>

    <a
      href="/login"
      class="btn btn-primary btn-lg">

      Login to Book

    </a>

  <% } %>

</div>
    <!-- OWNER BUTTONS -->

    <% if (
      currUser &&
      currUser._id.toString() === listing.owner._id.toString()
    ) { %>

      <div class="mt-4 d-flex gap-2 justify-content-center">

        <a
          href="/listings/<%= listing._id %>/edit"
          class="btn btn-warning">

          Edit Listing

        </a>

        <form
          method="POST"
          action="/listings/<%= listing._id %>?_method=DELETE"
          onsubmit="return confirm('Delete this listing?');">

          <button class="btn btn-danger">
            Delete Listing
          </button>

        </form>

      </div>

    <% } %>

    <hr>

    <!-- REVIEW FORM -->

    <div class="col-8 offset-2">

      <% if (currUser && currUser._id) { %>

        <h4 class="mb-4 text-primary">
          Leave a Review
        </h4>

        <form action="/listings/<%= listing._id %>/reviews" method="POST">
            <fieldset class="starability-slot">

    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
    <label for="first-rate1">1 star</label>

    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
    <label for="first-rate2">2 stars</label>

    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
    <label for="first-rate3">3 stars</label>

    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
    <label for="first-rate4">4 stars</label>

    <input type="radio" id="first-rate5" name="review[rating]" value="5" checked />
    <label for="first-rate5">5 stars</label>

  </fieldset>

  <!-- REVIEW -->

  <div class="mb-3">

    <label for="comment" class="form-label">
      Share your experience
    </label>

    <textarea
      id="comment"
      name="review[comment]"
      class="form-control"
      rows="6"
      placeholder="Example: I checked in around 11 PM. The property had CCTV cameras, security guards, and the area was well-lit. The host was friendly and I felt comfortable staying alone."
      required></textarea>

    <div class="form-text">
      Mention your experience about safety, cleanliness, host behaviour,
      late-night check-in, surrounding area, or anything else.
      Our AI will automatically analyze your review.
    </div>

  </div>

  <button class="btn btn-primary">
    Submit Review
  </button>




        </form>

      <% } %>

    </div>

    <hr>
    <div class="alert alert-success mt-4">

  <h5>
    🤖 AI Review Safety Score
  </h5>

  <h3>
    <%= reviewScore %>/100
  </h3>

  <p>

    <strong><%= safePercent %>%</strong>
    of guests felt safe.

  </p>

  <p>

    <strong><%= soloPercent %>%</strong>
    recommend this property for solo women travelers.

  </p>

</div>

    <!-- ALL REVIEWS -->

    <h4 class="mt-4 mb-3 text-primary">
      All Reviews
    </h4>

    <ul class="list-unstyled">

      <% for (let review of listing.reviews) { %>

        <li class="card mb-3 shadow-sm">

          <div class="card-body">

            <p>
              <strong>By:</strong>
              <%= review.author?.username || "Anonymous" %>
            </p>

            <p>
              <strong>Rating:</strong>
              <%= review.rating %>/5
            </p>

            <p>
              <strong>Comment:</strong>
              <%= review.comment %>
            </p>

            <p>
              <strong>Felt Safe:</strong>

              <span class="<%= review.feltSafe ? 'text-success' : 'text-danger' %>">

                <%= review.feltSafe ? "Yes" : "No" %>

              </span>
            </p>

            <p>
              <strong>Safe for Solo Women:</strong>

              <span class="<%= review.safeForSoloWomen ? 'text-success' : 'text-danger' %>">

                <%= review.safeForSoloWomen ? "Yes" : "No" %>

              </span>
            </p>

            <% if(review.lateNightExperience){ %>

              <p>
                <strong>Late Night Experience:</strong>
                <%= review.lateNightExperience %>
              </p>

            <% } %>

            <form
              method="POST"
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">

              <button class="btn btn-sm btn-danger">
                Delete
              </button>

            </form>

          </div>

        </li>

      <% } %>

        </ul>

  </div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>

const payBtn = document.getElementById("pay-btn");

if(payBtn){

  payBtn.addEventListener("click", async ()=>{

    try{

      const response = await fetch(
        "/create-order",
        {
          method:"POST",
          headers:{
            "Content-Type":"application/json"
          },
          body:JSON.stringify({
            amount:<%= listing.price %>,
            listingId:"<%= listing._id %>"
          })
        }
      );

      const order = await response.json();

      const options = {

        key: "<%= process.env.RAZORPAY_KEY_ID %>",

        amount:order.amount,

        currency:"INR",

        order_id:order.id,

        name:"SheStay",

        description:"Safe Stay Booking",

        handler: async function(response){

  const bookingResponse = await fetch(
    "/booking/success",
    {
      method:"POST",
      headers:{
        "Content-Type":"application/json"
      },
      body:JSON.stringify({
        listingId:"<%= listing._id %>",
        paymentId:response.razorpay_payment_id,
        orderId:response.razorpay_order_id,
        amount:<%= listing.price %>
      })
    }
  );

  const data = await bookingResponse.json();

  if(data.success){

    alert("Booking Confirmed!");

    window.location.href="/bookings";

  }

}

      };

      const rzp = new Razorpay(options);

      rzp.open();

    }
    catch(err){

      alert("Payment Failed");

    }

  });

}

</script>

</body>

